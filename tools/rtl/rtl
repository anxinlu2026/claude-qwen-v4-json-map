def cmd_blockcheck(args):
    """Feed the probed inputs of a block to the validated model and compare the model's output with the probed output."""
    ins, out, model, rest, i, cur = [], None, None, [], 0, None
    while i < len(args):
        a = args[i]
        if a == '--in':
            cur = 'in'
        elif a == '--out':
            out = args[i + 1]; i += 1; cur = None
        elif a == '--model':
            model = args[i + 1]; i += 1; cur = None
        elif a in ('--from', '--to', '--when', '--max', '--clk', '--tb'):
            rest += [a, args[i + 1]]; i += 1; cur = None
        elif cur == 'in':
            ins.append(a)
        else:
            die('Unexpected argument: ' + a)
        i += 1
    if not ins or not out or not model:
        die('Usage: rtl blockcheck --in SIGNAL [SIGNAL ...] --out SIGNAL --model "COMMAND" [--when "cond"] [--from T] [--to T] [--max N]\n'
            '  COMMAND is run in the folder of the validated model with the probed input values appended (hex, in the order given;\n'
            '  an input written =VALUE is passed to the model as that constant). %s in COMMAND is also accepted as the place of a value.\n'
            '  It must print the expected output value in hex. Signal names are written as for rtl probe.\n'
            '  A value held in several signals is written with +, first part highest: --in "a[0]+a[1]+a[2]+a[3]" --out "y[0]+y[1]+y[2]+y[3]".\n'
            '  e.g. rtl blockcheck --in a_sig b_sig =3 --out y_sig --model "python3 model.py block NAME"' + blocks_hint(load(), full=True))
    st = load(); mdir = st['model']['dir']
    if '--max' not in rest:
        rest += ['--max', '12']
    consts = {k: a[1:] for k, a in enumerate(ins) if a.startswith('=')}   # =VALUE: a constant argument for the model, not a signal
    sigs_in = [a for a in ins if not a.startswith('=')]
    n, edits, rows, more = cmd_probe(sigs_in + [out] + rest, collect=True)
    import shlex, subprocess
    cache, res = {}, []
    for r_ in rows:
        t, pv, vout = r_[0], list(r_[1:1 + len(sigs_in)]), r_[1 + len(sigs_in)]
        vin = [consts[k] if k in consts else pv.pop(0) for k in range(len(ins))]
        if any(re.search(r'[xXzZ]', v) for v in vin):
            res.append((t, vin, vout, '-', 'input unknown (x/z)')); continue
        key = tuple(vin)
        if key not in cache:
            try:
                # input values are appended to the command; a command written with %s placeholders gets them filled in order instead
                parts, left = [], list(vin)
                for tok in shlex.split(model):
                    while '%s' in tok and left:
                        tok = tok.replace('%s', left.pop(0), 1)
                    if '%s' not in tok:
                        parts.append(tok)
                argv_ = parts + left
                c = subprocess.run(argv_, cwd=mdir, capture_output=True, text=True, timeout=30)
            except subprocess.TimeoutExpired:
                die('BLOCKCHECK ERROR: the model command did not finish within 30 s.')
            if c.returncode != 0 or not c.stdout.strip():
                die(f'BLOCKCHECK ERROR: the model command failed in {mdir}: ' + ' '.join(argv_) + '\n' + (c.stderr or c.stdout).strip()[-400:] +
                    '\nThe command is run as: COMMAND followed by the probed input values in hex, in the order of --in (a constant is written =VALUE after --in). '
                    'Each block takes the inputs listed below, in that order.' + blocks_hint(st, full=True))
            cache[key] = c.stdout.strip().split()[-1].lower().replace('0x', '').replace('_', '')
        exp = cache[key]
        try:
            same = (not re.search(r'[xXzZ]', vout)) and int(vout, 16) == int(exp, 16)
        except ValueError:
            die(f'BLOCKCHECK ERROR: the model printed "{exp}", which is not a hex value.')
        res.append((t, vin, vout, exp, 'match' if same else 'MISMATCH'))
    print(f'BLOCKCHECK on RUN #{n} (design: {edits} edit(s) vs original)   model: {model}   (in {mdir})')
    heads = ['t'] + ins + [out + ' (RTL)', 'model', 'result']
    table = [[t] + vin + [vout, exp, verdict] for t, vin, vout, exp, verdict in res]
    w = [max([len(heads[k])] + [len(x[k]) for x in table]) for k in range(len(heads))]
    print(' | '.join(heads[k].rjust(w[k]) for k in range(len(heads))))
    for x in table:
        print(' | '.join(x[k].rjust(w[k]) for k in range(len(heads))))
    if more:
        print('... more rows exist: narrow with --from/--to/--when or raise --max')
    judged = [x for x in res if x[4] in ('match', 'MISMATCH')]
    bad = [x for x in judged if x[4] == 'MISMATCH']
    if not judged:
        print('No row could be compared (no rows, or inputs unknown). Choose the time/condition where the block is in use.'); return
    sig = next((w_ for w_ in reversed(re.findall(r'[A-Za-z_]\w*', out)) if w_ in design_signals()), None)
    print(f'RESULT: {len(judged) - len(bad)} of {len(judged)} compared row(s) match the model.')
    if not sig:
        print('(the output is not a design signal by name: nothing recorded)'); return
    st = load(); prev = st.setdefault('marks', {}).get(sig, {}); ev = st.setdefault('events', [])
    edited = prev.get('status') == 'mismatch' and 'replace' in ev[prev.get('ev', 0):]
    status = 'mismatch' if bad else ('fixed' if edited else 'match')
    b = bad[0] if bad else judged[0]
    note = f'golden={b[3]} observed={b[2]} source=model block "{model}" on probed inputs {" ".join(b[1])} at t={b[0]} ({len(judged) - len(bad)}/{len(judged)} rows match)'
    st['marks'][sig] = {'status': status, 'note': note, 'run': len(st['runs']), 'attempts': prev.get('attempts', 0), 'ev': prev.get('ev', len(ev)) if edited or (bad and prev.get('status') == 'mismatch') else len(ev)}
    ev.append('mark_' + status); save(st)
    if bad and edited:
        print(f'{sig}: still mismatch after your edit. The fix did not hold: rtl revert, then go back one level.')
    elif bad:
        print(f'{sig}: recorded as mismatch. With the inputs it actually receives, this block does not give the model\'s output: the fault is inside it. '
              'If it is more than one driver, break it down (blockcheck its parts); at a single driver, fix that driver.')
    elif edited:
        print(f'{sig}: recorded as fixed. Now: rtl sim')
    else:
        print(f'{sig}: recorded as match. This block is correct for the inputs it receives; go on to the next block (rtl next).')


def cmd_history(args):
    """Earlier commands and what they gave (also from earlier conversations): the way to find a comparison again."""
    hp = os.path.join(WORK, 'history.jsonl')
    n, word = 12, None
    for x in args:
        if x.isdigit():
            n = int(x)
        else:
            word = x.lower()
    rows = []
    if os.path.exists(hp):
        for line in open(hp, errors='replace').read().splitlines():
            try:
                rows.append(json.loads(line))
            except Exception:
                pass
    keep = [r for r in rows if r['cmd'].split(' ')[0] in ('sim', 'probe', 'blockcheck', 'mark', 'replace', 'insert', 'revert', 'model')
            and (not word or word in (r.get('line') or r['cmd']).lower())]
    if not keep:
        print('No earlier command' + (f' containing "{word}"' if word else '') + '.'); return
    print(f'Last {min(n, len(keep))} of {len(keep)} command(s)' + (f' containing "{word}"' if word else '') + ' (oldest first):')
    for r in keep[-n:]:
        out = [l.strip() for l in r['out'].splitlines() if l.strip()]
        key = [l for l in out if re.match(r'(RESULT:|RUN #|PROBE on|BLOCKCHECK|STOP:|CHECKPOINT|Design files restored|MODEL VALIDATION)', l) or 'recorded as' in l or re.match(r'\w+: (match|mismatch|fixed|nogolden)', l)]
        rowline = next((l for l in out if 'MISMATCH' in l or l.endswith('match')), None)
        print('  rtl ' + (r.get('line') or r['cmd'])[:600])
        for l in (key[:2] + ([rowline] if rowline else []) + key[2:3]):
            print('      -> ' + l[:240])


def cmd_mark(args):
    """Record the outcome of a comparison for one RTL signal."""
    st = load()
    ok = ('match', 'mismatch', 'fixed', 'nogolden')
    if len(args) < 2 or args[1] not in ok:
        die('Usage: rtl mark SIGNAL match|mismatch|fixed|nogolden "kind=control golden=REQUIRED observed=SEEN source=WHERE IT IS REQUIRED"   (control signals only; data values: rtl blockcheck)\n'
            '  match    = probed; inputs and output agree with golden\n'
            '  mismatch = probed; inputs agree with golden, output does not (this driver is the faulty circuit)\n'
            '  fixed    = after your edit, the same comparison now agrees with golden\n'
            '  nogolden = the validated model gives no golden value for this signal (then: rtl ask)')
    sig, status = args[0], args[1]
    if sig not in design_signals():
        die(f'"{sig}" is not a signal of the design. See: rtl signals')
    if status != 'nogolden' and sig not in st.get('probed', []) and not os.environ.get('RTL_NO_GATES'):
        die(f'STOP: "{sig}" has not been probed since the last edit. A status is recorded only after a comparison: rtl probe {sig} ... first.')
    note = ' '.join(args[2:])
    if status != 'nogolden' and 'kind=control' not in note.lower().replace(' ', '') and not os.environ.get('RTL_NO_GATES'):
        die('STOP: rtl mark records control signals only (state machines, counters, flags, handshakes), compared as a sequence with what the task or the '
            'standard requires: add kind=control to the note, e.g. rtl mark ' + sig + ' mismatch "kind=control golden=REQUIRED SEQUENCE observed=SEQUENCE SEEN source=WHERE IT IS REQUIRED".\n'
            'Data values are not marked by hand: rtl blockcheck --in INPUTS --out ' + sig + ' --model "COMMAND" compares them with the model and records the result.' + blocks_hint(st, full=True))
    if status != 'nogolden' and not os.environ.get('RTL_NO_GATES'):
        low = note.lower()
        if not ('golden' in low and 'observed' in low and 'source' in low):
            die('STOP: a comparison is recorded with its evidence. Give: "golden=VALUE observed=VALUE source=WHERE THE GOLDEN CAME FROM" '
                '(which output of the validated model, for which inputs). If no golden value can be obtained: rtl mark ' + sig + ' nogolden "why", then rtl ask.')
    elif status == 'nogolden' and len(note) < 10:
        die('Say why no golden value can be obtained: rtl mark ' + sig + ' nogolden "why"')
    prev = st.setdefault('marks', {}).get(sig, {})
    if status == 'fixed' and prev.get('status') != 'mismatch':
        die(f'"{sig}" was not marked mismatch before; "fixed" is for a driver that was located and then edited.')
    st['marks'][sig] = {'status': status, 'note': ' '.join(args[2:]), 'run': len(st['runs']), 'attempts': prev.get('attempts', 0), 'ev': len(st.get('events', []))}
    st.setdefault('events', []).append('mark_' + status); save(st)
    print(f'{sig}: {status}.' + ('  Now run: rtl sim' if status == 'fixed' else '  Now: rtl ask "..."' if status == 'nogolden' else '') + '   (what to do next: rtl next)')


def cmd_next(args):
    """Report on the current work order and get the next one (work-order mode), or tell the next step by fixed rules."""
    st = load(); rows = row_status(st)
    runs = [x for x in st['runs'] if not x.get('probe')]
    ev = st.get('events', [])
    cnt = collections.Counter(rows.values())
    head = (f'State: {n_edits()} edit(s) vs original; signals: ' + ', '.join(f'{cnt.get(k, 0)} {k}' for k in ('not_compared', 'match', 'mismatch', 'recheck', 'fixed', 'nogolden')) +
            (f'; last testbench run #{runs[-1]["n"]}: {runs[-1]["result"]}' if runs else '; no testbench run yet') +
            f'; task sheet {"approved" if st.get("sheet_approved") else "not approved"}; model {"validated" if st.get("model") else "not validated"}')
    if os.environ.get('RTL_NEXT_AI') and not os.environ.get('RTL_NO_GATES'):
        if os.path.exists(os.path.join(WORK, 'conv_done')):
            die('STOP: this conversation is complete. Write your closing lines as the final message; no further command is run.')
        report = ' '.join(args)
        low = report.lower()
        if not st.get('next_pending') and not all(w in low for w in ('found', 'evidence', 'unsure')):
            die('Usage: rtl next "found: WHAT YOU FOUND / evidence: WHICH RUN, PROBE OR FILE SHOWS IT / unsure: WHAT YOU ARE NOT SURE ABOUT (or: nothing)"\n'
                'Report on the current work order in these three parts; the orchestrator answers with the next work order.')
        import io, contextlib
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            _rule_next(st, rows, runs, ev)
        print(head)
        advise(st, head, buf.getvalue().strip(), report)
        return
    print(head)
    _rule_next(st, rows, runs, ev)


def advise(st, head, rule_text, question):
    """Ask the orchestrator (a senior engineer following the session) what to do next, and wait for the guidance."""
    box = os.environ.get('RTL_ASK_DIR', os.path.join(ROOT, 'rundir', '.orchestrator'))
    os.makedirs(box, exist_ok=True)
    pend = st.get('next_pending')
    k = pend if pend else st.get('next_asks', 0) + 1
    req, ans = os.path.join(box, f'request_next_{k}.md'), os.path.join(box, f'answer_next_{k}.md')
    if not pend:
        st['next_asks'] = k; st['next_pending'] = k; save(st)
        hist = []
        hp = os.path.join(WORK, 'history.jsonl')
        if os.path.exists(hp):
            for line in open(hp, errors='replace').read().splitlines()[-10:]:
                try:
                    h = json.loads(line); hist.append('$ rtl ' + h['cmd'][:400] + '\n' + h['out'][:1200])
                except Exception:
                    pass
        marks = '\n'.join(f'- {k_}: {v["status"]} (edits: {v.get("attempts", 0)}) {v.get("note", "")[:300]}' for k_, v in st.get('marks', {}).items()) or '(none)'
        open(req, 'w').write(f'[work order report, request {k}]\n\n{head}\n\n## Report\n{question or "(nothing given)"}\n\n'
                             f'## Recorded comparisons\n{marks}\n\n## Rule-based suggestion of the tool (for reference, not shown to the agent)\n{rule_text}\n\n'
                             '## Last commands and their output\n' + '\n\n'.join(hist) + '\n')
    limit = int(os.environ.get('RTL_NEXT_WAIT', '1800')); t0 = time.time()
    print(f'Report {k} sent to the orchestrator. Waiting for the next work order (up to {limit // 60} min). If this command is cut off, run rtl next again: it resumes the same report.', flush=True)
    while time.time() - t0 < limit:
        if os.path.exists(ans):
            time.sleep(1)
            st = load(); st['next_pending'] = None; st['order_t'] = time.time(); st.setdefault('events', []).append('advice'); save(st)
            text = open(ans).read().strip()
            print(f'ORCHESTRATOR ANSWER {k}:\n' + text)
            if text.upper().startswith('CONVERSATION COMPLETE'):
                open(os.path.join(WORK, 'conv_done'), 'w').write(str(k))
                print('-' * 60 + '\nThis conversation is complete. Write the closing lines the answer asks for as your final message. Do not run any further command.')
            return
        time.sleep(2)
    print(f'No answer within {limit // 60} min. Do not go on by yourself: run rtl next again later (it resumes the same report), or stop here.')


def _rule_next(st, rows, runs, ev):
    """Next step by fixed rules (used when no orchestrator is configured; in work-order mode it is sent along for reference)."""
    if os.environ.get('RTL_NO_GATES'):
        print('(gates are off)')
    else:
        bad = order_problem(st)
        if bad:
            print('NEXT: ' + bad); return
        why = must_ask(st)
        if why:
            print(f'NEXT: rtl ask "..."   ({why}). Report what you compared, what you found and what you need, and wait.'); return
        if not runs:
            print('NEXT: rtl sim   (run the testbench once on the untouched design and note what fails)'); return
        if os.environ.get('RTL_SHEET_REVIEW') and not st.get('sheet_approved'):
            print((f'NEXT: search {LIB} (INDEX.md); if it holds a model of the function, validate it now: rtl model DIR. Then write ' if not st.get('model') else 'NEXT: write ') +
                  f'the task sheet {SHEET}, rtl sheetsubmit and wait for the orchestrator\'s review.'); return
        why = model_ok(st)
        if why:
            print('NEXT: golden model: ' + why); return
    last_edit = max([i for i, e in enumerate(ev) if e in ('replace', 'revert')], default=-1)
    last_sim = max([i for i, e in enumerate(ev) if e == 'sim'], default=-1)
    last_rep = max([i for i, e in enumerate(ev) if e == 'replace'], default=-1)
    if last_rep >= 0 and ev[-1] != 'replace' and not any(e in ('mark_fixed', 'revert') for e in ev[last_rep + 1:]):
        ck = st['ckpts'][-1]['id'] if st.get('ckpts') else 'CHECKPOINT'
        print(f'NEXT: your last edit is not confirmed yet. Repeat the same comparison for the driver you edited. It now agrees -> it is recorded as fixed. '
              f'It does not agree, or it cannot be checked because an earlier stage is still wrong -> rtl revert {ck}, and deal with that earlier stage first. '
              'An edit that is not confirmed is not kept: there is no third choice.'); return
    if ev and ev[-1] == 'replace':
        print('NEXT: rtl sim, then repeat the same comparison for the driver you just edited (rtl probe ...). Model and RTL agree and the run is not worse -> recorded as fixed (blockcheck does it; a control signal: rtl mark SIGNAL fixed "kind=control ..."). Otherwise rtl revert.'); return
    back = [k for k, v in rows.items() if v == 'recheck']
    if back:
        print(f'NEXT: the fix of {back[0]} was reverted. Go back one level: probe the stage upstream of its driver against the model again '
              '(the golden value, or an input judged "match", may be wrong), then rtl mark what you find.'); return
    located = [k for k, v in rows.items() if v == 'mismatch']
    if len(located) > 1:
        print('NEXT: ' + str(len(located)) + ' faulty drivers are recorded: ' + ', '.join(located) + '. Fix ONE, the earliest in the chain of cause: the one whose own inputs are '
              'correct. If one of them is wrong only because another has not happened yet (it waits for it, is started by it, or reads it), fix that other one first; '
              'a fix downstream of an unfixed fault cannot be confirmed. Then rtl sim and repeat the same comparison.'); return
    if located:
        print(f'NEXT: fix the driver of {located[0]} only (rtl show, rtl replace), then rtl sim and repeat the same comparison.'); return
    if last_edit > last_sim:
        print('NEXT: rtl sim   (a fix was kept or reverted since the last testbench run)'); return
    if runs and runs[-1]['result'] == 'PASS':
        print('NEXT: the testbench passes. Check the cases the task names but the testbench does not exercise (rtl sim --tb FILE), then report.'); return
    rest = [k for k, v in rows.items() if v == 'not_compared']
    if rest:
        print('NEXT: choose the block to compare: start at the failing output and go back toward the inputs, one block at a time (probe-signal skill). '
              'rtl blockcheck --in INPUTS --out OUTPUT --model "COMMAND" feeds the probed inputs to the model and records match / mismatch. '
              'Control signals (state machines, counters, done flags): compare their sequence by rtl probe, then rtl mark SIGNAL match|mismatch "kind=control ...".')
        print(f'      {len(rest)} signal(s) not compared yet: ' + ', '.join(rest[:10]) + (' ...' if len(rest) > 10 else '')); return
    print('NEXT: every signal has been compared and the testbench still fails. Narrow down from the failing output with the probe-signal skill; '
          'if it points to logic the RTL does not have, rtl ask "..." and wait.')


PROBES_WITHOUT_MARK = int(os.environ.get('RTL_PROBES_WITHOUT_MARK', '3'))


def probes_since(st):
    """Probe runs since the last recorded comparison, edit, revert or answer."""
    since = 0
    for e in reversed(st.get('events', [])):
        if e.startswith('mark_') or e in ('replace', 'revert', 'ask', 'model'):
            break
        since += e == 'probe'
    return since


def must_ask(st):
    """Reason why the next step has to be `rtl ask` (None when it does not). These are the points where
    the probing method has not got there and the agent must report instead of finding another way."""
    if st.get('ask_needed'):
        return st['ask_needed']
    marks = st.get('marks', {})
    for k, v in marks.items():
        if v['status'] == 'nogolden':
            return f'no golden value could be obtained for {k}'
        if v['status'] == 'recheck' and v.get('attempts', 0) >= 2:
            return f'the driver of {k} was edited {v["attempts"]} times and reverted each time'
    ev = st.get('events', [])
    runs = [x for x in st.get('runs', []) if not x.get('probe')]
    if st.get('model') and runs and runs[-1]['result'] != 'PASS':
        rows = row_status(st)
        last_edit = max([i for i, e in enumerate(ev) if e in ('replace', 'revert')], default=-1)
        last_sim = max([i for i, e in enumerate(ev) if e == 'sim'], default=-1)
        if rows and all(v in ('match', 'fixed') for v in rows.values()) and last_sim > last_edit:
            return 'every signal has been compared and the testbench still fails'
    return None


def program_files(base_dirs=None):
    """Program files written during the session outside the model work folder."""
    found = []
    for base in (base_dirs or ('/tmp', ROOT)):
        for dp, dn, fn in os.walk(base):
            if dp.startswith(WORK) or (not base_dirs and dp.startswith(MODEL_WORK)) or '/.orchestrator' in dp or '/node_modules' in dp or '/qwen-home' in dp or '/.cache' in dp or dp == '/tmp/pilot' or dp.startswith('/tmp/pilot/'):
                continue   # /tmp/pilot holds the inputs and tools the orchestrator provides (v4)
            for f in fn:
                if f.endswith(('.py', '.c', '.cc', '.cpp', '.pl', '.js', '.rb', '.go', '.rs', '.java')):
                    found.append(os.path.join(dp, f))
    return sorted(found)


def order_problem(st):
    """Work done out of order or outside the method: a program outside the model folder, or a model before the task sheet."""
    progs = program_files()
    if progs:
        return ('STOP: program files were written outside the model folder: ' + ', '.join(progs[:6]) + ('.' if len(progs) <= 6 else ' ...') +
                f' A model is built only in {MODEL_WORK}/NAME, after the task sheet is approved, and is used only after rtl model has validated it. '
                'Move them there or delete them, or explain with: rtl ask "..."')
    if os.environ.get('RTL_SHEET_REVIEW') and not st.get('sheet_approved') and os.path.isdir(MODEL_WORK) and any(fn for dp, dn, fn in os.walk(MODEL_WORK)):
        return (f'STOP: out of order: {MODEL_WORK} holds files but the task sheet has not been approved. The task sheet comes before the golden model: '
                'write it and run rtl sheetsubmit. (A model of the library may be validated before the task sheet; one you build comes after it.)')
    return None


def gate(cmd, args=()):
    """Order of work: one baseline run, the task sheet, the validated golden model, then probing and editing."""
    if os.environ.get('RTL_NO_GATES'):
        return
    if os.path.exists(os.path.join(WORK, 'conv_done')):
        die('STOP: this conversation is complete. Write your closing lines as the final message; no further command is run.')
    st = json.load(open(STATE)) if os.path.exists(STATE) else {}
    bad = order_problem(st)
    if bad and cmd not in ('status', 'show', 'diff', 'log'):
        die(bad)
    if st and cmd == 'probe' and not os.environ.get('RTL_NEXT_AI') and probes_since(st) >= PROBES_WITHOUT_MARK:
        die(f'STOP: {probes_since(st)} probe runs without a recorded comparison. Record what they showed before probing again: data values -> rtl blockcheck '
            '(the tool compares with the model and records it); a control sequence -> rtl mark SIGNAL match|mismatch "kind=control ..."; '
            'if neither is possible -> rtl ask "...".' + blocks_hint(st, full=True))
    why = must_ask(st) if st else None
    if why and cmd in ('probe', 'replace', 'insert', 'mark', 'sim'):
        die(f'STOP: {why}. The method has not got there: do not look for another way. Report to the orchestrator now with rtl ask "what you compared, what you found, what you need" and wait for the answer.')
    if st.get('hash') and st['hash'] != design_hash() and cmd not in ('revert', 'diff', 'status', 'show'):
        die('STOP: the design files in rtl/ were changed without `rtl replace`. Edits must go through `rtl replace` so that each one has a '
            'checkpoint and a comparison. Undo the outside change with: rtl revert last')
    # before the task sheet: reading, one run of the testbench on the untouched design, and validating a model of the library
    lib_model = cmd == 'model' and len(args) == 1 and os.path.realpath(args[0]).startswith(os.path.realpath(LIB) + os.sep)
    if cmd in ('show', 'signals', 'log', 'status', 'diff') or lib_model or (cmd == 'sim' and not [x for x in st.get('runs', []) if not x.get('probe')]):
        return
    if not os.path.exists(SHEET):
        die(f'STOP: {SHEET} does not exist. Classify the task and write the task sheet first (see the kick-off instructions); then run this command again.')
    text = open(SHEET, errors='replace').read().lower()
    missing = [i for i in SHEET_ITEMS if i not in text]
    if missing:
        die(f'STOP: the task sheet {SHEET} is incomplete. Missing items (headings containing): ' + ', '.join(missing) + '. Complete it, then run this command again.')
    # an item must have content of its own: no placeholders, and some text before the next heading
    raw = open(SHEET, errors='replace').read()
    parts = re.split(r'(?m)^#+\s*(.+)$', raw)
    unfilled = []
    for k in range(1, len(parts) - 1, 2):
        head, body = parts[k].strip(), parts[k + 1].strip()
        if head.lower().startswith('task sheet'):  # the document title, not an item
            continue
        if any(i in head.lower() for i in SHEET_ITEMS):
            if len(body) < 15 or re.search(r'\b(tbd|to be filled|to be done|to be determined|fill in later|later)\b', (head + ' ' + body).lower()):
                unfilled.append(head[:50])
    if unfilled:
        die(f'STOP: these task sheet items are not filled in yet: ' + '; '.join(unfilled) + '. Read what is needed (for testbench items: the testbench) and write them now; "to be done" is not accepted.')
    if os.environ.get('RTL_SHEET_REVIEW') and not os.environ.get('RTL_SKIP_SHEET_REVIEW'):
        cur = hashlib.sha1(open(SHEET, 'rb').read()).hexdigest()
        if not st.get('sheet_approved') or st.get('sheet_hash') != cur:
            die('STOP: the task sheet has not been approved by the orchestrator' + (' since it was last changed' if st.get('sheet_approved') else '') +
                '. Submit it for review with: rtl sheetsubmit   (it waits for the answer)')
    if cmd in ('replace', 'insert', 'mark', 'blockcheck'):
        why = model_ok(st)
        if why:
            die('STOP: ' + why)


