def dir_hash(d):
    h = hashlib.sha1()
    for dp, dn, fn in sorted(os.walk(d)):
        if '__pycache__' in dp:
            continue
        for f in sorted(fn):
            h.update(os.path.relpath(os.path.join(dp, f), d).encode()); h.update(open(os.path.join(dp, f), 'rb').read())
    return h.hexdigest()


def model_ok(st):
    """None when a validated model is on record and unchanged; otherwise the reason it is not."""
    m = st.get('model')
    if not m:
        return (f'no validated golden model is on record. Search {LIB} (INDEX.md) for a model of the function; if there is none, build one in '
                f'{MODEL_WORK}/NAME from the standard, with a validate.py that compares its outputs with an independent trusted source. Then: rtl model DIR')
    if not os.path.isdir(m['dir']) or dir_hash(m['dir']) != m['hash']:
        return f'the model in {m["dir"]} was changed after its validation. Validate it again: rtl model {m["dir"]}'
    return None


def blocks_hint(st, full=False):
    """Where the blocks of the validated model are listed (BLOCKS.txt in its folder), or the list itself."""
    m = st.get('model')
    if not m:
        return ''
    f = os.path.join(m['dir'], 'BLOCKS.txt')
    if not os.path.exists(f):
        return ''
    return ('\nBlocks of the validated model (' + f + '):\n' + open(f, errors='replace').read().rstrip()) if full else f'  Model blocks: {f}'


def cmd_model(args):
    """Run a model's validation and record the result. Probing and editing need a validated model."""
    if len(args) != 1:
        die(f'Usage: rtl model DIR   (a model folder in {LIB}/ip_models, or one you built in {MODEL_WORK}/NAME; it must hold validate.py or validate.sh)')
    d = os.path.realpath(args[0])
    lib = d.startswith(os.path.realpath(LIB) + os.sep)
    if not os.path.isdir(d) or not (lib or d.startswith(os.path.realpath(MODEL_WORK) + os.sep)):
        die(f'A model is a folder in the library ({LIB}/ip_models/NAME) or one you built in {MODEL_WORK}/NAME.')
    v = next((x for x in ('validate.py', 'validate.sh') if os.path.exists(os.path.join(d, x))), None)
    if not v:
        die(f'{d} has no validate.py / validate.sh. A model is validated by a script that compares its outputs with an independent trusted source '
            '(an established implementation, values printed by the standard, the testbench values) and ends with a line HARNESS PASS or HARNESS FAIL.')
    import subprocess
    try:
        r = subprocess.run((['python3', '-B'] if v.endswith('.py') else ['sh']) + [v], cwd=d, capture_output=True, text=True, timeout=600)
        out, rc = (r.stdout + r.stderr).strip(), r.returncode
    except subprocess.TimeoutExpired:
        out, rc = 'validation did not finish within 10 minutes', 1
    passed = rc == 0 and 'HARNESS PASS' in out
    tail = '\n'.join(out.splitlines()[-25:])
    print(f'MODEL VALIDATION in {d} ({v}): ' + ('PASS' if passed else 'FAIL') + '\n' + tail)
    st = load()
    if not passed:
        st['model'] = None; save(st)
        print('Not validated: its values are not golden. Correct the model (not the validation) and run rtl model again; if it cannot be made to pass: rtl ask "..."')
        return
    if not lib:  # a model built or changed in the session: the orchestrator reviews what it was validated against
        doc = os.path.join(WORK, 'model_review.md')
        files = sorted(os.path.relpath(os.path.join(dp, f), d) for dp, dn, fn in os.walk(d) for f in fn if '__pycache__' not in dp)
        open(doc, 'w').write(f'Model folder: {d}\nFiles: ' + ', '.join(files) + f'\n\n## {v}\n```\n' + open(os.path.join(d, v), errors='replace').read() +
                             '\n```\n\n## validation output\n```\n' + tail + '\n```\n')
        if not review('model', doc, 'model'):
            st = load(); st['model'] = None; save(st)
            print('The model is NOT accepted. Do what the review asks, then run rtl model again.')
            return
        st = load()
    st['model'] = {'dir': d, 'hash': dir_hash(d), 'library': lib, 't': time.time()}
    st.setdefault('events', []).append('model'); save(st)
    print('The model is validated and on record: its values can be used as golden (rtl next tells the next step).' + blocks_hint(st, full=True))


def review(kind, path, flag):
    """Send a document to the orchestrator and wait for APPROVED / REDO."""
    st = load()
    box = os.environ.get('RTL_ASK_DIR', os.path.join(ROOT, 'rundir', '.orchestrator'))
    os.makedirs(box, exist_ok=True)
    cur = hashlib.sha1(open(path, 'rb').read()).hexdigest()
    pend = st.get(flag + '_pending')
    if pend and pend['hash'] == cur:   # the same document is still waiting (the earlier wait was cut off)
        k = pend['k']
        req, ans = os.path.join(box, f'request_{kind}_{k}.md'), os.path.join(box, f'answer_{kind}_{k}.md')
        print(f'Submission {k} is still waiting for its review: waiting on it again.', flush=True)
    else:
        k = st.get(flag + '_submits', 0) + 1; st[flag + '_submits'] = k; st[flag + '_pending'] = {'k': k, 'hash': cur}; save(st)
        req, ans = os.path.join(box, f'request_{kind}_{k}.md'), os.path.join(box, f'answer_{kind}_{k}.md')
        open(req, 'w').write(f'[{kind} submitted for review, submission {k}]\n\n' + open(path, errors='replace').read())
    limit = int(os.environ.get('RTL_ASK_WAIT', '1800')); t0 = time.time()
    print(f'Submission {k} sent to the orchestrator. Waiting for the review (up to {limit // 60} min). If this command is cut off, run it again: it resumes the same submission.', flush=True)
    while time.time() - t0 < limit:
        if os.path.exists(ans):
            time.sleep(1)
            text = open(ans).read().strip()
            ok = text.upper().startswith('APPROVED')
            st = load(); st[flag + '_approved'] = ok; st[flag + '_pending'] = None; st['order_t'] = time.time()   # waiting for a review is not the agent's time
            st[flag + '_hash'] = hashlib.sha1(open(path, 'rb').read()).hexdigest() if ok else None
            save(st)
            print(f'ORCHESTRATOR REVIEW {k}: ' + text)
            return ok
        time.sleep(3)
    print(f'No review within {limit // 60} min. Do not continue without approval: summarise your state and stop.')
    return False


