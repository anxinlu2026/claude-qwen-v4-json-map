#!/usr/bin/env python3
"""rtl - helper for RTL debug sessions: compile+simulate, probe signals, edit by line number, checkpoints.

Spec: skills_trial/rtl_tool_spec.md.  Only operations are provided: no reference models, no hidden tests.
Environment: RTL_ROOT (default /code; design in <root>/rtl, testbench in <root>/verif),
             RTL_WORK (default /tmp/rtlwork; run output, checkpoints and state live here).
Needs iverilog/vvp on PATH and the Python standard library only.
"""
import collections, difflib, hashlib, json, os, re, shutil, subprocess, sys, time

ROOT = os.environ.get('RTL_ROOT', '/code')
WORK = os.environ.get('RTL_WORK', '/tmp/rtlwork')
STATE = os.path.join(WORK, 'state.json')
KEYWORDS = {'input', 'output', 'inout', 'logic', 'wire', 'reg', 'bit', 'signed', 'unsigned', 'parameter', 'localparam',
            'begin', 'end', 'if', 'else', 'for', 'assign', 'always', 'always_ff', 'always_comb', 'module', 'endmodule',
            'generate', 'endgenerate', 'genvar', 'int', 'integer', 'function', 'task', 'case', 'endcase', 'initial'}
# Messages that are folded into one summary line. Whole-line patterns only (never a keyword such as "sorry"/"warning").
FOLD = [('"constant selects" notice', re.compile(r"^.*: sorry: constant selects in always_\* processes are not fully supported \(the process will be sensitive to all bits in '.*'\)\.?$")),
        ('"VCD dumpfile opened" notice', re.compile(r'^VCD info: dumpfile .* opened for output\.$'))]


def die(msg):
    print(msg); sys.exit(1)


def srcs(sub):
    d = os.path.join(ROOT, sub)
    return sorted(os.path.join(d, f) for f in os.listdir(d) if f.endswith(('.sv', '.v'))) if os.path.isdir(d) else []


def rel(p):
    return os.path.relpath(p, ROOT)


def load():
    os.makedirs(WORK, exist_ok=True)
    if os.path.exists(STATE):
        return json.load(open(STATE))
    st = {'start': time.time(), 'runs': [], 'ckpts': [], 'baseline': None, 'marks': {}, 'probed': [], 'events': []}
    os.makedirs(os.path.join(WORK, 'orig'), exist_ok=True)  # untouched copy of the design, taken on first use
    for f in srcs('rtl'):
        shutil.copy2(f, os.path.join(WORK, 'orig', os.path.basename(f)))
    st['hash'] = design_hash(); snap_last()
    save(st)
    return st


def save(st):
    json.dump(st, open(STATE, 'w'), indent=1)


def design_hash():
    h = hashlib.sha1()
    for f in srcs('rtl'):
        h.update(os.path.basename(f).encode()); h.update(open(f, 'rb').read())
    return h.hexdigest()


def snap_last():
    """Keep a copy of the design as the tool last left it (used to undo changes made outside the tool)."""
    dst = os.path.join(WORK, 'ckpt', 'last'); os.makedirs(dst, exist_ok=True)
    for f in srcs('rtl'):
        shutil.copy2(f, os.path.join(dst, os.path.basename(f)))


def design_signals():
    d = design()
    return [s_ for n_, md in d['mods'].items() if md['file'] not in d['tb'] for s_ in md['sigs']]


def row_status(st):
    """Status of every RTL signal: not_compared until a comparison is recorded with `rtl mark`
    (match, mismatch, fixed, nogolden); recheck = its fix was reverted and the level upstream is to be compared again."""
    out = {}
    for s_ in dict.fromkeys(design_signals()):
        m = st.get('marks', {}).get(s_)
        out[s_] = m['status'] if m else 'not_compared'
    return out


# ---------- light RTL parsing: names only (modules, instances, declared signals) ----------
def strip_comments(t):
    t = re.sub(r'/\*.*?\*/', lambda m: re.sub(r'[^\n]', ' ', m.group(0)), t, flags=re.S)
    return re.sub(r'//[^\n]*', '', t)


def parse(files):
    mods = {}
    for f in files:
        t = strip_comments(open(f, errors='replace').read())
        for m in re.finditer(r'\bmodule\s+(\w+)(.*?)\bendmodule\b', t, re.S):
            mods[m.group(1)] = {'file': f, 'body': m.group(2), 'insts': [], 'sigs': {}}
    for name, md in mods.items():
        body = md['body']
        for m in re.finditer(r'(?m)^[ \t]*(\w+)\s*(?:#\s*\((?:[^()]|\([^()]*\))*\)\s*)?(\w+)\s*\(', body):
            if m.group(1) in mods and m.group(2) not in KEYWORDS:
                # instances inside a generate-for get an indexed scope name that is not resolved here
                pre = body[:m.start()]
                in_gen = pre.count('generate') - 2 * pre.count('endgenerate') > 0 and re.search(r'for\s*\(\s*genvar', pre.split('endgenerate')[-1] or '')
                md['insts'].append((m.group(2), m.group(1), bool(in_gen)))
        params = {k: v for k, v in re.findall(r"\b(?:localparam|parameter)\s+(?:\w+\s+)?(\w+)\s*=\s*(?:\d*'d)?(\d+)\b", body)}
        head = re.compile(r"\b(?:(input|output|inout)\b\s*(?:logic|wire|reg|bit)?|(?:logic|wire|reg|bit))\b\s*(?:signed\b\s*)?((?:\[[^\]]*\]\s*)*)")
        item = re.compile(r'\s*(\w+)\s*((?:\[[^\]]*\]\s*)*)')
        gens = [(g.start(), g.end()) for g in re.finditer(r'\bgenerate\b.*?\bendgenerate\b', body, re.S) if re.search(r'for\s*\(\s*genvar', g.group(0))]
        pos = 0
        while True:
            h = head.search(body, pos)
            if not h:
                break
            pos = h.end()
            while True:
                it = item.match(body, pos)
                if not it or it.group(1) in KEYWORDS:
                    break
                dims = []
                for d in re.findall(r'\[([^\]]*)\]', it.group(2)):
                    d = d.strip(); d = params.get(d, d)
                    r = re.fullmatch(r'(\d+)\s*:\s*(\d+)', d)
                    dims.append(abs(int(r.group(1)) - int(r.group(2))) + 1 if r else int(d) if d.isdigit() else None)
                md['sigs'].setdefault(it.group(1), {'range': ' '.join(h.group(2).split()), 'dir': h.group(1) or '', 'dims': dims,
                                                    'gen': any(a <= h.start() < b for a, b in gens)})
                pos = it.end()
                nxt = re.match(r'\s*,', body[pos:])
                if not nxt:
                    break
                pos += nxt.end()
    return mods


def design(tb=None):
    rtl, tbs = srcs('rtl'), ([tb] if tb else srcs('verif'))
    if not rtl:
        die(f'No design files found in {ROOT}/rtl.')
    mods = parse(rtl + tbs)
    used = {i[1] for m in mods.values() for i in m['insts']}
    tops = [n for n, m in mods.items() if m['file'] in tbs and n not in used]
    top = tops[0] if tops else None
    scopes = {}  # hierarchical path -> module name

    def walk(path, mod):
        scopes[path] = mod
        for inst, child, in_gen in mods[mod]['insts']:
            if not in_gen:
                walk(path + '.' + inst, child)
    if top:
        walk(top, top)
    return {'rtl': rtl, 'tb': tbs, 'mods': mods, 'top': top, 'scopes': scopes}


def resolve(d, name):
    """Signal name (optionally 'scope.signal', optional [..] suffix) -> (full path, info) or (None, hint)."""
    if d['top'] and name.startswith(d['top'] + '.'):
        # full hierarchical path given (needed for signals inside generate loops): used as written
        return name, {'range': '?', 'dims': [], 'dir': '', 'raw': True, 'suffix': ''}
    m = re.fullmatch(r'([\w.]+?)((?:\[[^\]]*\])*)', name)
    if not m:
        return None, f'cannot read signal name "{name}"'
    base, suffix = m.group(1), m.group(2)
    scope_hint, sig = base.rsplit('.', 1) if '.' in base else (None, base)
    hits = []
    for path, mod in d['scopes'].items():
        if sig in d['mods'][mod]['sigs']:
            if scope_hint is None or path.endswith('.' + scope_hint) or path == scope_hint or mod == scope_hint or scope_hint in path.split('.')[-1] or scope_hint in mod:
                hits.append((path, mod))
    if len(hits) > 1 and scope_hint is None:
        # prefer the place where the signal is not just a port passed down; if still ambiguous, ask
        inner = [h for h in hits if not d['mods'][h[1]]['sigs'][sig]['dir']]
        if len(inner) == 1:
            hits = inner
        else:
            return None, f'signal "{sig}" exists in several places: ' + ', '.join(f'{d["scopes"][p]}.{sig}' for p, _ in hits) + '. Write module.signal.'
    if not hits:
        if scope_hint and scope_hint.split('.')[0] in (d['top'],) + tuple(d['scopes']):
            return base + suffix, {'range': '?', 'dims': [], 'dir': '', 'raw': True}  # full path given by the user (e.g. inside a generate block)
        allsigs = sorted({(s, mod) for mod in set(d['scopes'].values()) for s in d['mods'][mod]['sigs']})
        near = difflib.get_close_matches(sig, sorted({s for s, _ in allsigs}), n=5, cutoff=0.5)
        where = '; '.join(f'{n} ({", ".join(sorted({m for s, m in allsigs if s == n}))})' for n in near)
        return None, f'signal "{name}" not found.' + (f' Similar names: {where}' if near else ' See: rtl signals')
    path, mod = hits[0]
    if d['mods'][mod]['sigs'][sig].get('gen'):
        return None, f'"{sig}" is declared inside a generate loop in module {mod}: write its full path with the loop block name and index, e.g. {path}.BLOCK[0].{sig} (see the "begin : BLOCK" label in the source).'
    return path + '.' + sig + suffix, dict(d['mods'][mod]['sigs'][sig], suffix=suffix)


# ---------- running the simulator ----------
def run_sim(d, st, probe_text=None, timeout=50, until=None):
    n = len(st['runs']) + 1
    rd = os.path.join(WORK, 'run'); os.makedirs(rd, exist_ok=True)
    if not d['top']:
        die('No testbench found in ' + ROOT + '/verif (nothing to simulate). Use: rtl sim --tb FILE with your own test.')
    files = d['rtl'] + d['tb']
    cmd = ['iverilog', '-g2012', '-s', d['top']]
    if probe_text:
        pf = os.path.join(rd, 'rtl_probe.sv'); open(pf, 'w').write(probe_text)
        cmd += ['-s', 'rtl_probe']; files = files + [pf]
    # the simulation is stopped at a time limit, so a testbench that waits for something that never happens still
    # gives its output. The limit is `until` (asked for by the caller), else ten times the time the untouched
    # design needed, else (first run) none. The stop is a module of its own: the testbench file is not touched.
    limit = until if until else (10 * st['tb_end'] if st.get('tb_end') else None)
    sf = os.path.join(rd, 'rtl_stop.sv')
    open(sf, 'w').write('module rtl_stop;\n' + (f'  initial begin #{int(limit)} $display("@STOP %0d", $time); $finish; end\n' if limit else '') +
                        '  final $display("@END %0d", $time);\nendmodule\n')
    cmd += ['-s', 'rtl_stop']; files = files + [sf]   # last in the list: it takes the time unit of the testbench
    out = os.path.join(rd, 'sim.out')
    c = subprocess.run(cmd + ['-o', out] + files, capture_output=True, text=True, cwd=rd)
    comp = [l for l in (c.stdout + c.stderr).splitlines() if l.strip()]
    sim, timed_out = [], False
    if c.returncode == 0:
        try:
            r = subprocess.run(['vvp', out], capture_output=True, text=True, cwd=rd, timeout=timeout)
            sim = (r.stdout + r.stderr).splitlines()
        except subprocess.TimeoutExpired as e:
            timed_out = True
            sim = ((e.stdout or b'').decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')).splitlines()
    os.makedirs(os.path.join(WORK, 'runs'), exist_ok=True)
    open(os.path.join(WORK, 'runs', f'{n}.full.txt'), 'w').write('### compile\n' + '\n'.join(comp) + '\n### simulation\n' + '\n'.join(sim) + '\n')
    global LAST_STOP, LAST_END
    LAST_STOP = next((int(l.split()[1]) for l in sim if l.startswith('@STOP ')), None)
    LAST_END = next((int(l.split()[1]) for l in sim if l.startswith('@END ')), None)
    sim = [l for l in sim if not l.startswith(('@STOP ', '@END ')) and 'rtl_stop.sv' not in l]
    return n, c.returncode, comp, sim, timed_out


LAST_STOP = LAST_END = None


def nokey(l):
    return re.sub(r'^\S+?:\d+: ', '', l)  # same message on a shifted line number is still the same message


def fold(lines, baseline):
    """Split lines into (shown, folded counts). A line is folded only if it matches a FOLD pattern AND was already
    present in the first run of the untouched design; anything new is always shown."""
    shown, counts = [], collections.Counter()
    for l in lines:
        label = next((lab for lab, pat in FOLD if pat.match(l)), None)
        if label and (baseline is None or nokey(l) in baseline['lines']):
            counts[label] += 1
        else:
            shown.append(l)
    return shown, counts


def n_edits():
    n = 0
    for f in srcs('rtl'):
        o = os.path.join(WORK, 'orig', os.path.basename(f))
        a = open(o, errors='replace').read().splitlines() if os.path.exists(o) else []
        n += sum(1 for op in difflib.SequenceMatcher(None, a, open(f, errors='replace').read().splitlines()).get_opcodes() if op[0] != 'equal')
    return n


def cmd_sim(args, probe=None):
    tb = args[args.index('--tb') + 1] if '--tb' in args else None
    until = int(args[args.index('--until') + 1]) if '--until' in args else None
    d, st = design(tb), load()
    n, rc, comp, sim, timed_out = run_sim(d, st, probe[0] if probe else None, until=until)
    if not probe and not tb and LAST_STOP is None and LAST_END is not None and st.get('tb_end') is None and n_edits() == 0:
        st['tb_end'] = LAST_END   # how long the testbench runs on the untouched design
    if st['baseline'] is None and n_edits() == 0 and not probe:
        st['baseline'] = {'lines': sorted({nokey(l) for l in comp + sim}), 'counts': {lab: sum(1 for l in comp + sim if pat.match(l)) for lab, pat in FOLD}}
    cshown, ccount = fold(comp, st['baseline'])
    psim = [l for l in sim if not l.startswith('@P ')]
    sshown, scount = fold(psim, st['baseline'])
    counts = ccount + scount
    npass = sum(1 for l in sshown if re.search(r'\bpass(ed)?\b', l, re.I))
    nfail = sum(1 for l in sshown if re.search(r'\b(fail(ed)?|mismatch)\b', l, re.I) or re.match(r'\s*(ERROR|FATAL):', l))
    result = 'COMPILE ERROR' if rc else 'TIMEOUT' if timed_out else 'NOT FINISHED' if (LAST_STOP is not None and not probe) else 'FAIL' if nfail else 'PASS' if npass else 'UNKNOWN'
    digest = hashlib.sha1('\n'.join(sshown).encode()).hexdigest()[:12]
    prev = next((r for r in reversed(st['runs']) if r['result'] != 'COMPILE ERROR' and not r.get('probe')), None)
    edits = n_edits()
    if not probe:
        st.setdefault('events', []).append('sim')
    st['runs'].append({'n': n, 'result': result, 'npass': npass, 'nfail': nfail, 'digest': digest, 'edits': edits, 'probe': bool(probe),
                       'ckpt': st['ckpts'][-1]['id'] if st['ckpts'] else None, 't': time.time(),
                       'first_fail': next((l.strip() for i, l in enumerate(sshown) if re.search(r'observed|actual|got', l, re.I)), '')})
    save(st)
    hidden = ''.join(f'\n(hidden: {c} x {lab}' + (f', original design had {st["baseline"]["counts"].get(lab, 0)}' if st['baseline'] else '') + f'; full text: rtl log {n} --full)' for lab, c in counts.items())
    if rc:
        errs = [l for l in cshown if 'error' in l.lower()] or cshown
        print(f'RUN #{n}  compile: ERROR ({len(errs)} message(s))   design: {edits} edit(s) vs original')
        print('\n'.join(cshown[:25]) + (f'\n... {len(cshown) - 25} more line(s): rtl log {n}' if len(cshown) > 25 else '') + hidden)
        return None
    cmp_ = '' if not prev else '   vs RUN #%d: %s' % (prev['n'], 'same output' if prev['digest'] == digest else 'output changed')
    if probe:
        return n, edits, sim, cshown, hidden
    print(f'RUN #{n}  compile: OK   result: {result}' + (f' ({nfail} FAIL, {npass} PASS)' if result in ('FAIL', 'PASS') else '') + cmp_ + f'   design: {edits} edit(s) vs original')
    if prev and prev['digest'] == digest and prev.get('edits') != edits and result != 'PASS':
        print('The edit made since that run changed nothing in the testbench output. Repeat the comparison for the driver you edited; if it does not agree, '
              'or cannot be checked because an earlier stage is still wrong: rtl revert, and deal with the earlier stage first.')
    if timed_out:
        print('Simulation did not finish within the time limit (possible endless loop or a wait that never completes).')
    if LAST_STOP is not None:
        print(f'The testbench had not finished at simulation time {LAST_STOP}' + (f' (the untouched design finished at {st["tb_end"]})' if st.get('tb_end') else '') +
              '. It is waiting for something that has not happened by then. Probe the signals it waits for (rtl probe ... --to T stops at T), '
              f'or let it run longer with: rtl sim --until N' + (f'   ({nfail} FAIL, {npass} PASS printed so far)' if nfail or npass else ''))
    if cshown:
        print('compile messages:\n' + '\n'.join(cshown[:15]) + (f'\n... {len(cshown) - 15} more: rtl log {n}' if len(cshown) > 15 else ''))
    body = sshown if len(sshown) <= 30 else sshown[:18] + [f'... {len(sshown) - 28} line(s) omitted: rtl log {n} ...'] + sshown[-10:]
    print('\n'.join(body) + hidden)
    if result == 'UNKNOWN':
        print('(No PASS/FAIL wording in the testbench output: judge the result from the lines above.)')


def cmd_signals(args):
    d = design()
    word = args[0].lower() if args else None
    if not d['top']:
        print('(no testbench found: listing design modules only)')
    paths = d['scopes'] or {m: m for m in d['mods']}
    for path, mod in paths.items():
        sigs = d['mods'][mod]['sigs']
        if word is None:
            print(f'{path}   (module {mod}, {len(sigs)} signals)')
            continue
        hit = {s: i for s, i in sigs.items() if word in s.lower() or word == mod.lower() or word in path.split('.')[-1].lower()}
        if hit:
            print(path)
            for s, i in hit.items():
                arr = ' x '.join(str(x or '?') for x in i['dims'])
                print(f'  {s:<22} {i["range"] or "1 bit":<14}' + (f' array {arr}' if arr else '') + (f'   {i["dir"]}' if i['dir'] else '') + ('   (inside a generate loop)' if i.get('gen') else ''))
    gen = [(m, i[0]) for m, md in d['mods'].items() for i in md['insts'] if i[2]]
    if word is None:
        print('Use: rtl signals WORD   (signal name part, module name or instance name)')
        if gen:
            print('Not listed: instances created inside generate loops (' + ', '.join(sorted({f"{m}/{i}" for m, i in gen})) + ') and signals declared inside generate blocks; give their full path to rtl probe.')


def cmd_probe(args, collect=False):
    opts, names, i = {'--from': None, '--to': None, '--when': None, '--max': '40', '--clk': None, '--tb': None}, [], 0
    while i < len(args):
        if args[i] in opts:
            opts[args[i]] = args[i + 1]; i += 2
        else:
            names.append(args[i]); i += 1
    if not names:
        die('Usage: rtl probe SIGNAL [SIGNAL ...] [--from T] [--to T] [--when "cond"] [--max N] [--clk SIGNAL] [--tb FILE]')
    d = design(opts['--tb'])
    if not d['top']:
        die('No testbench found: nothing to simulate.')
    cols, errs = [], []

    def col_for(nme):
        path, info = resolve(d, nme)
        if path is None:
            errs.append(info); return None
        # unpacked array without an element index: print all elements joined, first index first
        given = len(re.findall(r'\[', info.get('suffix', '')))
        unp = info['dims']
        left = unp[given:] if given <= len(unp) else []
        if left:
            if any(x is None for x in left) or (lambda p: p > 64)(__import__('functools').reduce(lambda a, b: a * b, left, 1)):
                errs.append(f'"{nme}" is an array ({" x ".join(str(x or "?") for x in unp)}): give an element, e.g. {nme}' + ''.join('[0]' for _ in left)); return None
            idx = [[]]
            for n_ in left:
                idx = [a + [k] for a in idx for k in range(n_)]
            expr = '{' + ','.join(path + ''.join(f'[{k}]' for k in a) for a in idx) + '}'
            return (nme + ''.join('[]' for _ in left), expr, '%h')
        else:
            one = (not info['range']) and not re.search(r':', info.get('suffix', '')) and info['range'] != '?'
            nr = re.fullmatch(r'\[\s*(\d+)\s*:\s*(\d+)\s*\]', info['range'] or '')
            small = nr and abs(int(nr.group(1)) - int(nr.group(2))) < 8 and not info.get('suffix')
            return (nme, path, '%h' if collect else '%b' if one else '%0d' if small else '%h')

    for nme in names:
        if '+' in nme:   # several signals joined into one value, the first one in the highest position
            parts = [col_for(x.strip()) for x in nme.split('+') if x.strip()]
            if all(parts):
                cols.append((nme, '{' + ','.join(x[1] for x in parts) + '}', '%h'))
        else:
            c_ = col_for(nme)
            if c_:
                cols.append(c_)
    if errs:
        die('PROBE ERROR: ' + '\nPROBE ERROR: '.join(errs))
    clk = opts['--clk']
    if clk:
        cpath, info = resolve(d, clk)
        if cpath is None:
            die('PROBE ERROR (clock): ' + info)
    else:
        tops = d['mods'][d['top']]['sigs']
        c = next((s for s in ('clk', 'clock', 'i_clk', 'clk_i', 'CLK', 'aclk') if s in tops), None) or next((s for s in tops if 'clk' in s.lower() or 'clock' in s.lower()), None)
        if not c:
            die('PROBE ERROR: no clock signal found in the testbench (design may be purely combinational). Use --clk SIGNAL to choose the sampling signal.')
        cpath = d['top'] + '.' + c
    cond = []
    if opts['--from']:
        cond.append(f'$time >= {int(opts["--from"])}')
    if opts['--to']:
        cond.append(f'$time <= {int(opts["--to"])}')
    if opts['--when']:
        def sub(m):
            p, _ = resolve(d, m.group(0))
            return p if p and m.group(0) not in KEYWORDS else m.group(0)
        cond.append('(' + re.sub(r"(?<![\w'.$])[A-Za-z_][\w.]*", sub, opts['--when']) + ')')
    mx = int(opts['--max'])
    fmt = ' | '.join(f for _, _, f in cols)
    probe = ('module rtl_probe;\n  integer n = 0;\n  always @(posedge ' + cpath + ')\n    if (' + (' && '.join(cond) or '1') + ') begin\n'
             f'      if (n < {mx}) $display("@P %0t | {fmt}", $time, ' + ', '.join(e for _, e, _ in cols) + ');\n'
             f'      else if (n == {mx}) $display("@P MORE");\n      n = n + 1;\n    end\nendmodule\n')
    r = cmd_sim((['--tb', opts['--tb']] if opts['--tb'] else []) + (['--until', str(int(opts['--to']) + 1)] if opts['--to'] else []), probe=(probe,))
    st_ = load()
    if r is not None:   # a probe that did not compile showed nothing: it is not counted
        st_.setdefault('probed', []).extend(w for nme in names for w in re.findall(r'[A-Za-z_]\w*', nme))
        if not collect:   # the probe inside rtl blockcheck is not counted against the limit of probes without a record
            st_.setdefault('events', []).append('probe')
        save(st_)
    if r is None:
        print('PROBE ERROR: the design or the probe did not compile (messages above). If the messages mention rtl_probe.sv, a probed name does not exist at that place: check it with rtl signals WORD (a name can be written without its path; only a signal inside a generate loop needs the full path that rtl signals shows).')
        sys.exit(1)
    n, edits, sim, cshown, hidden = r
    rows = [l[3:].split(' | ') for l in sim if l.startswith('@P ') and l != '@P MORE']
    more = any(l == '@P MORE' for l in sim)
    if collect:
        return n, edits, [[x.strip() for x in r_] for r_ in rows], more
    heads = ['t'] + [c[0] for c in cols]
    w = [max(len(heads[k]), *(len(r_[k].strip()) for r_ in rows)) if rows else len(heads[k]) for k in range(len(heads))]
    print(f'PROBE on RUN #{n} (design: {edits} edit(s) vs original)   {len(rows)} row(s), sampled at each rising edge of {cpath}')
    print('(each row shows the values just before that clock edge, i.e. what the flip-flops see at that edge)')
    if not rows:
        print('No rows: the clock never rose within the selected time/condition. Check --from/--to/--when, or whether the simulation ended early.')
    else:
        print(' | '.join(heads[k].rjust(w[k]) for k in range(len(heads))))
        for r_ in rows:
            print(' | '.join(r_[k].strip().rjust(w[k]) for k in range(len(heads))))
    if more:
        print(f'... more rows exist: narrow with --from/--to/--when or raise --max (now {mx})')
    if LAST_STOP is not None and not opts['--to']:
        print(f'(the simulation was stopped at time {LAST_STOP}: the testbench had not finished. --to T stops at the time you choose.)')
    tb_out = [l for l in fold([l for l in sim if not l.startswith('@P ')], load()['baseline'])[0] if re.search(r'pass|fail|expected|observed|error', l, re.I)]
    if tb_out:
        print('testbench said: ' + ' / '.join(l.strip() for l in tb_out[:6]))
    left = PROBES_WITHOUT_MARK - probes_since(load())
    if not os.environ.get('RTL_NEXT_AI'):
      print('Record what this shows before looking further' + (f' ({left} more probe(s) allowed without a record)' if left > 0 else ' (no further probe until something is recorded)') +
          ': data values -> rtl blockcheck (the tool compares with the model); control sequence -> rtl mark SIGNAL match|mismatch "kind=control ...".' + blocks_hint(load()))


