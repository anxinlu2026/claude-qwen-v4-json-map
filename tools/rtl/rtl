        die('Usage: rtl revert CHECKPOINT   (e.g. c3, "original", or "last" = the design as rtl last left it)   Checkpoints: ' + ' '.join(c['id'] for c in st['ckpts']))
    src = os.path.join(WORK, 'orig') if args[0] == 'original' else os.path.join(WORK, 'ckpt', args[0])
