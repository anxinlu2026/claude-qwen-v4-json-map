  rtl revert CHECKPOINT         restore a checkpoint ("original" = the untouched files)
  rtl diff [CHECKPOINT]         what has changed vs the original (or vs a checkpoint)
  rtl status                    summary of edits, runs and time used
  rtl log N [--full]            output of run N (--full = unfiltered)
  rtl history [N] [WORD]        earlier commands and their results, also from earlier conversations (WORD = part of the command)
  rtl ask "MESSAGE"             notify the orchestrator and wait for instructions
  rtl sheetsubmit               submit the task sheet to the orchestrator for review and wait
  rtl model DIR                 run the validation of a golden model and record it (needed before comparing and editing)
  rtl blockcheck --in SIG.. --out SIG --model "CMD"   feed the probed inputs of a block to the model, compare its output, record the result
  rtl mark SIGNAL STATUS "golden=.. observed=.. source=.."   record a comparison: match | mismatch | fixed | nogolden
  rtl next "found: .. / evidence: .. / unsure: .."   report on the current work order; the orchestrator answers with the next one"""

if __name__ == '__main__':
    a = sys.argv[1:]
    table = {'sim': cmd_sim, 'signals': cmd_signals, 'probe': cmd_probe, 'show': cmd_show, 'replace': cmd_replace, 'insert': cmd_insert,
             'checkpoint': cmd_checkpoint, 'revert': cmd_revert, 'diff': cmd_diff, 'status': cmd_status, 'log': cmd_log, 'ask': cmd_ask, 'model': cmd_model, 'blockcheck': cmd_blockcheck, 'history': cmd_history, 'mark': cmd_mark, 'next': cmd_next, 'sheetsubmit': cmd_sheetsubmit}
    if not a or a[0] not in table:
        print(HELP); sys.exit(0 if not a or a[0] in ('help', '-h', '--help') else 1)
    # a note the orchestrator left for the agent is delivered with the next command, whatever it is
    _box = os.environ.get('RTL_ASK_DIR', os.path.join(ROOT, 'rundir', '.orchestrator'))
    _note = os.path.join(_box, 'note.md')
    if os.path.exists(_note):
        _n = len([f for f in os.listdir(_box) if f.startswith('note_delivered_')]) + 1
        print('ORCHESTRATOR NOTE (read this first):\n' + open(_note, errors='replace').read().strip() + '\n' + '-' * 60, flush=True)
        os.rename(_note, os.path.join(_box, f'note_delivered_{_n}.md'))
    # keep a short history of commands and their output: it is what the orchestrator sees when asked for guidance
    import atexit, io
    class _Tee(io.TextIOBase):
        def __init__(self, real): self.real, self.buf = real, []
        def write(self, x):
            self.buf.append(x)
            try:
                return self.real.write(x)
            except BrokenPipeError:
                return len(x)
        def flush(self):
            try:
                self.real.flush()
            except BrokenPipeError:
                pass
    _tee = _Tee(sys.stdout); sys.stdout = _tee
    def _keep():
        try:   # tell how much of the work order's time is used: the agent has no clock of its own
            lim = int(os.environ.get('RTL_ORDER_LIMIT_S', '0'))
            if lim and a[0] not in ('next', 'ask', 'sheetsubmit') and os.path.exists(STATE):
                t0_ = json.load(open(STATE)).get('order_t')
                if t0_:
                    used = time.time() - t0_
                    msg = f'[work order: {used / 60:.0f} min used of {lim / 60:.0f}]'
                    if used > 0.6 * lim:
                        msg += ' Time is nearly up: report now what you have with rtl next "found / evidence / unsure". An incomplete report is better than none.'
                    _tee.real.write(msg + '\n'); _tee.real.flush()
        except Exception:
            pass
        try:
            os.makedirs(WORK, exist_ok=True)
            open(os.path.join(WORK, 'history.jsonl'), 'a').write(json.dumps({'t': time.time(), 'cmd': ' '.join(a), 'line': __import__('shlex').join(a), 'out': ''.join(_tee.buf)[:3000]}) + '\n')
        except Exception:
            pass
    atexit.register(_keep)
    if a[0] not in ('ask', 'next', 'sheetsubmit', 'history'):
        gate(a[0], a[1:])
    table[a[0]](a[1:])
