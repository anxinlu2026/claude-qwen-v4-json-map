def cmd_replace(args):
    if len(args) != 3:
        die('Usage: rtl replace FILE FIRST LAST   (new text on standard input; FIRST..LAST are replaced)\nTo insert without removing, use: rtl insert FILE AFTER_LINE')
    st = load(); f = find_file(args[0])
    if f not in srcs('rtl'):
        die('Only design files under rtl/ can be edited with this command (the testbench is the reference and is left untouched).')
    a, b = int(args[1]), int(args[2]); lines = open(f, errors='replace').read().split('\n')
    if not (1 <= a <= b + 1 <= len(lines) + 1):
        die(f'Line range {a}-{b} is outside the file (1-{len(lines)}).')
    new = sys.stdin.read().rstrip('\n').split('\n') if not sys.stdin.isatty() else []
    located = [k for k, v in st.get('marks', {}).items() if v['status'] == 'mismatch']
    ev_ = st.get('events', [])
    last_rep = max([i for i, e in enumerate(ev_) if e == 'replace'], default=-1)
    settled = any(e in ('mark_fixed', 'revert') for e in ev_[last_rep + 1:]) if last_rep >= 0 else True
    if not settled and not os.environ.get('RTL_NO_GATES'):
        die('STOP: the previous edit has not been settled. Repeat the same comparison for the driver you edited; then either rtl mark SIGNAL fixed "golden=... observed=... source=..." or rtl revert. Only then make another edit.')
    if not located and not os.environ.get('RTL_NO_GATES'):
        die('STOP: no comparison has located a faulty driver yet. Probe the inputs and outputs of the code against golden; when a '
            'driver has matching inputs and a wrong output, record it with: rtl mark SIGNAL mismatch "golden vs observed". Then edit that driver. '
            'If you believe a change is needed without such a comparison, ask first: rtl ask "..."')
    cid = checkpoint(st, f'before edit of {rel(f)} lines {a}-{b}')
    old = lines[a - 1:b]
    lines[a - 1:b] = new
    open(f, 'w').write('\n'.join(lines))
    print(f'CHECKPOINT {cid} saved (state before this edit).  {rel(f)}: lines {a}-{b} ({len(old)} line(s)) replaced by {len(new)} line(s)')
    for k, l in enumerate(old[:12]):
        print(f'- {a + k:>4}: {l}')
    if len(old) > 12:
        print(f'-  ... {len(old) - 12} more removed line(s)')
    for k, l in enumerate(new[:12]):
        print(f'+ {a + k:>4}: {l}')
    if len(new) > 12:
        print(f'+  ... {len(new) - 12} more new line(s)')
    st['hash'] = design_hash(); snap_last(); st['probed'] = []; st.setdefault('events', []).append('replace')
    for k in located:
        st['marks'][k]['attempts'] = st['marks'][k].get('attempts', 0) + 1
    save(st)
    print(f'Next: rtl sim, then repeat the same comparison for this driver (rtl probe ...). rtl blockcheck (data) records it as fixed when it agrees with the model; a control signal: rtl mark SIGNAL fixed "kind=control ...". If it does not hold: rtl revert {cid}')


