    back = [k for k, v in st.get('marks', {}).items() if v['status'] == 'mismatch' and v.get('attempts', 0) >= 1]
    for k in back:
        st['marks'][k]['status'] = 'recheck'
    st['hash'] = design_hash(); snap_last(); st['probed'] = []; st.setdefault('events', []).append('revert'); save(st)
    print(f'Design files restored to {args[0]} ({n_edits()} edit(s) vs original). The state before the revert was kept as {keep}.')
    if back:
        print('The fix of ' + ', '.join(back) + ' did not hold. Go back one level: the golden value, or an input judged "match", may be wrong. '
              'Probe the stage upstream of this driver against the model again, then record it with rtl mark.')


