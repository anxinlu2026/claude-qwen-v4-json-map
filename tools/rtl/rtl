        die(f'Checkpoint "{args[0]}" not found. Checkpoints: original ' + ' '.join(c['id'] for c in st['ckpts']))
    import tempfile
    tmp = tempfile.mkdtemp()
    for f in os.listdir(src):
        shutil.copy2(os.path.join(src, f), os.path.join(tmp, f))  # copy first: 'last' is overwritten by the checkpoint below
    keep = checkpoint(st, f'before revert to {args[0]}')
    for f in srcs('rtl'):
