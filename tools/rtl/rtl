def cmd_ask(args):
    """Send a message to the orchestrator and block until an answer arrives (or the wait limit passes)."""
    if not args:
        die('Usage: rtl ask "what you tried, what you found, what you need"')
    st = load()
    box = os.environ.get('RTL_ASK_DIR', os.path.join(ROOT, 'rundir', '.orchestrator'))
    os.makedirs(box, exist_ok=True)
    resume = st.get('ask_pending')
    n = resume if resume else st.get('asks', 0) + 1
    st['asks'] = n; st['ask_pending'] = n; save(st)
    status = []
    runs = [x for x in st['runs'] if not x.get('probe')]
    if runs:
        status.append(f'last run #{runs[-1]["n"]}: {runs[-1]["result"]}')
    status.append(f'{n_edits()} edit(s) vs original; {len(st["runs"])} simulator runs; {(time.time() - st["start"]) / 60:.0f} min since first use')
    req, ans = os.path.join(box, f'request_{n}.md'), os.path.join(box, f'answer_{n}.md')
    why = must_ask(st)
    rows = row_status(st)
    table = '; '.join(f'{k}={v}' for k, v in rows.items() if v in ('mismatch', 'recheck', 'fixed', 'match', 'nogolden'))
    if resume:
        print(f'Request {n} is still waiting for its answer: waiting on it again (the request text is unchanged).', flush=True)
    else:
      open(req, 'w').write(' '.join(args) + '\n\n[status] ' + '; '.join(status) + (f'\n[forced by tool] {why}' if why else '') +
                         (f'\n[comparisons recorded] {table}' if table else '\n[comparisons recorded] none') + '\n')
    limit = int(os.environ.get('RTL_ASK_WAIT', '1800')); t0 = time.time()
    print(f'Request {n} sent to the orchestrator. Waiting for the answer (up to {limit // 60} min). If this command is cut off, run rtl ask again: it resumes the same request.', flush=True)
    while time.time() - t0 < limit:
        if os.path.exists(ans):
            time.sleep(1)
            st = load(); st['ask_needed'] = None; st['ask_pending'] = None; st.setdefault('events', []).append('ask')
            for k, v in st.get('marks', {}).items():   # the reported cases start afresh after the answer
                if v['status'] == 'nogolden':
                    v['status'] = 'asked'
                if v['status'] in ('mismatch', 'recheck'):
                    v['attempts'] = 0
            save(st)
            print(f'ORCHESTRATOR ANSWER {n}:\n' + open(ans).read().strip())
            return
        time.sleep(3)
    print(f'No answer within {limit // 60} min. Do not change the method on your own: summarise what is confirmed and what is not, and stop.')


